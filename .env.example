# ============================================================================
# FRUITY FUN JUICE FACTORY MANAGEMENT ERP SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local inside apps/web (and root) and fill in real keys.
# Never commit real secrets or service role keys to version control!
# ============================================================================

# 1. SUPABASE CLOUD DATABASE & AUTHENTICATION
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 1B. SERVER-SIDE SESSION SIGNING & INITIAL ACCOUNT PROVISIONING (SERVER-ONLY)
ERP_SESSION_SECRET="replace-with-32-byte-random-hmac-secret"
INITIAL_OWNER_PASSWORD="replace-with-owner-initial-password"
INITIAL_KAMRAN_PASSWORD="replace-with-kamran-manager-initial-password"
INITIAL_IMRAN_PASSWORD="replace-with-imran-manager-initial-password"

# 2. CLAUDE AI (ANTHROPIC) FOR VOICE TRANSACTIONS & BUSINESS INTELLIGENCE
ANTHROPIC_API_KEY="your-anthropic-api-key"

# 3. GOOGLE MAPS API FOR LIVE BOOKER GPS & GEOFENCING
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-javascript-api-key"

# 4. ANDROID RELEASE APK SIGNING CONFIGURATION (CI / GRADLE ENVIRONMENT ONLY)
ANDROID_KEYSTORE_PATH="/secure/path/to/juice-factory-release.jks"
ANDROID_KEYSTORE_PASSWORD="your-keystore-password"
ANDROID_KEY_ALIAS="juice-factory-key"
ANDROID_KEY_PASSWORD="your-key-password"
